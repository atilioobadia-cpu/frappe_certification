 "prepared_report": 0,
 "query": "\n        SELECT \n            add_on.item AS \"Add-on Type:Link/Airplane Ticket Add-on Type:200\",\n            COUNT(*) AS \"Sold Count:Int:100\"\n        FROM `tabAirplane Ticket Add-on Item` add_on\n        JOIN `tabAirplane Ticket` ticket ON ticket.name = add_on.parent\n        WHERE ticket.docstatus = 1\n        GROUP BY add_on.item\n        ORDER BY COUNT(*) DESC\n    ",
